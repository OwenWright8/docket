{
  "name": "docket",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Self-hosted to-do list and reminders that a local AI fills in for you, with email triage and a daily summary",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "dev:demo": "node --disable-warning=ExperimentalWarning scripts/demo.ts",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.3.2",
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@tanstack/react-query": "^5.83.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.462.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sonner": "^1.7.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}
