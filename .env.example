# NOTHING IN THIS FILE IS REQUIRED.
#
# Docket is configured in its web UI (local AI, notifications, email).
# Docker Compose reads a file named `.env` next to docker-compose.yml
# automatically: copy this to `.env` and uncomment what you want to change.

# --- Time zone ----------------------------------------------------------------
# What "today" means, when timed reminders fire and when the morning summary
# goes out. Defaults to America/Indiana/Indianapolis in the compose file.
# TZ=America/Chicago

# --- Port ---------------------------------------------------------------------
# The port the app is published on (host side). Default 8585.
# APP_PORT=8585

# --- Update reminder ----------------------------------------------------------
# Every 6 hours the server asks GitHub for the latest release (one anonymous
# GET of a public URL; nothing about you is sent) and the sidebar shows a note
# when there's a new one. Browsers never contact GitHub.
# UPDATE_CHECK=on             # "off" for no requests and no reminder

# --- Pin the version ----------------------------------------------------------
# Defaults to the latest release. Set a tag (e.g. v1.0.0), or a minor series
# (e.g. 1.0, which still gets bug-fix releases), to control when upgrades happen.
# DOCKET_VERSION=latest
